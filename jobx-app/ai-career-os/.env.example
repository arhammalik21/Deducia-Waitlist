# App
# Production: set to your public URL (used for auth redirects / absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:7777
NODE_ENV=development

# Database (Docker Compose defaults)
DATABASE_URL=postgresql://career:career@localhost:5433/ai_career_os?schema=public

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required for local signup without confirmation emails (avoids rate limits)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Google OAuth (direct — not via Supabase provider UI)
# Create a Web OAuth client in Google Cloud Console and set:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match an Authorized redirect URI on the Google client:
# GOOGLE_REDIRECT_URI=http://localhost:7777/auth/google/callback
# Also required so we can create a Supabase session after Google login:
# SUPABASE_SERVICE_ROLE_KEY=...

# AI Gateway (OpenAI-compatible)
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-ai-api-key
AI_MODEL_DEFAULT=gpt-4o-mini
AI_MODEL_STRONG=gpt-4o

# Matching
MATCH_SCORER_VERSION=v1

# Storage (local filesystem for MVP; swap to S3/Supabase Storage later)
RESUME_UPLOAD_DIR=./storage/resumes

# Personal mail notifications (Resend). Without these, mail is logged locally.
# RESEND_API_KEY=re_xxxxxxxx
# MAIL_FROM=JobX <onboarding@yourdomain.com>
